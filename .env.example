# Copy to .env and fill in your values.

# Provider: deepinfra | groq | openrouter
LLM_PROVIDER=deepinfra

# DeepInfra / OpenAI-compatible key (used when LLM_PROVIDER=deepinfra)
OPENAI_API=your_deepinfra_or_openai_api_key_here

# Groq key (used when LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter key (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

SERPER_API_KEY=your_serper_api_key_here

# Optional DeepInfra overrides (used when LLM_PROVIDER=deepinfra)
MODEL_URL=https://api.deepinfra.com/v1/openai
MODEL=deepseek-ai/DeepSeek-V3

# Optional Groq overrides (used when LLM_PROVIDER=groq)
# GROQ_MODEL_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional OpenRouter overrides (used when LLM_PROVIDER=openrouter)
# OPENROUTER_MODEL_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Postgres (SQLAlchemy / users & speeches). LanceDB path is separate.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/speechgen
LANCEDB_URL=./data/lancedb

# JWT (required for /process and /api/speeches)
JWT_SECRET_KEY=change-me-to-a-long-random-string
# JWT_ACCESS_TOKEN_EXPIRES=86400

# Langfuse observability (optional — agent works without these)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: compact prompts for test_agent.py --eval (production /process unchanged)
# AGENT_EVAL_MODE=0
# EVAL_MAX_TOOL_RESULT_CHARS=1200
